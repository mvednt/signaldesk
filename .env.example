# SignalDesk — environment variable names ONLY. No real secrets here.
# Copy to .env.local and fill with real values for local dev.
# Set the same names in the Vercel project (Production + Preview).

# --- Runtime AI (Gemini Flash ONLY — no Claude API at runtime) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Signal sources ---
NEWS_API_KEY=
# Google News RSS needs no key.

# --- Email (Hot List delivery via Resend) ---
RESEND_API_KEY=
HOTLIST_FROM_EMAIL=onboarding@resend.dev
HOTLIST_TO_EMAIL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduling / cron auth ---
CRON_SECRET=

# --- Google sign-in (identity only; no Gmail API / no sensitive scopes) ---
# From a Google Cloud OAuth 2.0 "Web application" client. Authorized redirect
# URIs must include <origin>/api/auth/callback for every origin you use
# (e.g. http://localhost:3000/api/auth/callback and the Vercel URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ char string used to sign the session cookie. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# --- App ---
APP_TIMEZONE=Asia/Kolkata
# Account "warmth" score decays to 0 over this many days (default 30).
# The Hot List uses a separate strict 3-day window.
SIGNAL_DECAY_DAYS=30
